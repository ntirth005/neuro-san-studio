                            "type": "string",
                            "description": "Optional sales channel for sellability analysis."
                        },
                        "horizon_days": {
                            "type": "integer",
                            "description": "Planning horizon in days."
                        }
                    },
                    "required": ["action"]
                }
            }
        },


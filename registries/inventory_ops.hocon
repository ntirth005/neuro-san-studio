        {
            "name": "InventoryQualityTool",
            "class": "coded_tools.inventory_ops.inventory_quality_tool.InventoryQualityTool",
            "function": {
                "description": "Explains stock variances, prioritizes cycle counts, separates usable and unusable batches, models expiry waste, routes returns, detects recurring discrepancies, groups quality signals, and checks recall exposure.",
                "parameters": {

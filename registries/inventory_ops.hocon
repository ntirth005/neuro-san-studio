        # Tool 19: Operations Control & Audit Engine
        {
            "name": "OperationsControlTool",
            "class": "coded_tools.inventory_ops.operations_control_tool.OperationsControlTool",
            "function": {
                "description": "Builds the daily exception queue, summarizes changes, tracks approvals, explains recommendation changes, checks integration health, creates idempotent PO drafts, gates PO sends, creates reversals, explains recommendations, and reports action status.",
                "parameters": {
                    "type": "object",

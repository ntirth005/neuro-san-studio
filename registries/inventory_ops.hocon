                        },
                        "notes": {
                            "type": "string",
                            "description": "Optional context for a follow-up draft."
                        }
                    },
                    "required": ["action"]
                }
            }
        },

        # Tool 14: Supplier Sourcing Engine
        {
            "name": "SupplierSourcingTool",
            "class": "coded_tools.inventory_ops.supplier_sourcing_tool.SupplierSourcingTool",
            "function": {
                "description": "Scores supplier reliability from receipts, evaluates short shipments, delay impact, price changes, alternate suppliers, and supplier failure scenarios.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": ["supplier_scorecard", "shortfall_options", "delay_impact",
                                     "price_change_eval", "alternate_suppliers", "supplier_failure_sim"],
                            "description": "Sourcing action to execute."
                        },
                        "supplier_id": {
                            "type": "string",
                            "description": "Optional supplier identifier."
                        },
                        "po_id": {
                            "type": "string",
                            "description": "Optional purchase order identifier."
                        },
                        "sku": {
                            "type": "string",
                            "description": "Optional SKU for alternate sourcing."
                        },
                        "quantity": {
                            "type": "integer",
                            "description": "Quantity needed for alternate sourcing."
                        },
                        "available_qty": {
                            "type": "integer",
                            "description": "Supplier-confirmed available quantity for shortfall analysis."
                        },
                        "delay_days": {
                            "type": "integer",
                            "description": "Supplier delay in days."
                        },
                        "new_unit_cost": {
                            "type": "number",
                            "description": "Revised unit cost for price-change analysis."
                        }
                    },
                    "required": ["action"]
                }
            }
        }

        # Tool 15: Multi-Location Fulfillment Engine
        {
            "name": "NetworkFulfillmentTool",
            "class": "coded_tools.inventory_ops.network_fulfillment_tool.NetworkFulfillmentTool",
            "function": {
                "description": "Compares transfer fulfillment with buying stock, ranks location stockout risk, finds excess-to-shortage transfers, reconciles in-transit transfers, explains channel sellability, detects allocation conflicts, simulates redistribution, and models fulfillment-center closure.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "action": {
                            "type": "string",
                            "enum": ["fulfill_options", "location_stockout_risk", "transfer_candidates",
                                     "in_transit", "sellability_check", "allocation_conflicts",
                                     "redistribute_plan", "closure_simulation"],
                            "description": "Multi-location action to execute."
                        },
                        "sku": {
                            "type": "string",
                            "description": "Optional SKU to focus the analysis."
                        },
                        "quantity": {
                            "type": "integer",
                            "description": "Order or transfer quantity."
                        },
                        "order_id": {
                            "type": "string",
